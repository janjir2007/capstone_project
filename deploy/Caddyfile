# Caddy = HTTPS reverse proxy in front of the Streamlit UI (task 6.1, D-061; login 8.5r, D-117).
# DOMAIN comes from .env (docker-compose.prod.yml). Caddy picks the certificate itself:
#   a public name (app.geoexpert.mn, 1.2.3.4.sslip.io) -> Let's Encrypt, renewed automatically
#   localhost                                           -> Caddy's own local CA (browser warns once)
# Live since task 8.3: DOMAIN=app.geoexpert.mn, OLD_DOMAIN=168.144.143.203.sslip.io.

{$DOMAIN} {
	encode zstd gzip

	# Public API routes: the health check (uptime checks, docs/deploy.md) and, since task 8.5r
	# (D-117), the login pages. Every other API route stays inside the compose network (D-061).
	handle /health {
		reverse_proxy api:8000
	}

	# Login / logout / cookie check. X-Real-IP = the real TCP peer as Caddy sees it, which
	# REPLACES any X-Real-IP the browser sent; the API counts wrong passwords per this IP
	# (5 wrong -> 15 min lock), so a fake X-Forwarded-For cannot dodge the lock.
	handle /auth/* {
		request_body {
			max_size 8KB
		}
		reverse_proxy api:8000 {
			header_up X-Real-IP {remote_host}
		}
	}

	# Everything else = the UI, but only with a valid login cookie: forward_auth asks the API
	# (GET /auth/check, the browser's Cookie header copied) before EVERY request, including
	# Streamlit's websocket /_stcore/stream. 2xx -> passed on; otherwise the API's 302 to
	# /auth/login?next=<path> goes back to the browser.
	# reverse_proxy passes WebSockets by default. Body limit = Streamlit's 15 MB upload limit (+ form).
	handle {
		forward_auth api:8000 {
			uri /auth/check
		}
		request_body {
			max_size 16MB
		}
		reverse_proxy ui:8501
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# Task 8.3: the previous public address (OLD_DOMAIN in .env, e.g. the <ip>.sslip.io name) keeps
# its certificate and sends every request to the same path on DOMAIN, so old links and
# bookmarks still work. 302 = temporary for now (PM, 8.3): browsers do not cache it, so a
# rollback works at once. Switch to `permanent` (301) after 2 weeks stable (docs/deploy.md §11).
# Without OLD_DOMAIN in .env, compose fills in
# old.localhost (never matched; a block address cannot be empty, Caddy refuses to start).
{$OLD_DOMAIN} {
	redir https://{$DOMAIN}{uri} temporary
}
