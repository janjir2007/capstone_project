# Production settings for docker-compose.prod.yml (task 6.1).
# On the server:  cp .env.prod.example .env   then replace EVERY "CHANGE_ME".
# .env is git-ignored: real values never go into git (RISK-06).

# --- Public address (Caddy gets the HTTPS certificate for it)
# A domain whose DNS A record points at the server, e.g. service.<company-domain>,
# or without a domain: <server-ip>.sslip.io (e.g. 203.0.113.10.sslip.io).
# Local test of the whole stack: localhost
DOMAIN=CHANGE_ME
# Optional: a previous public address, redirected to DOMAIN (task 8.3). Leave empty if none.
# Live server: OLD_DOMAIN=168.144.143.203.sslip.io (DOMAIN=app.geoexpert.mn)
OLD_DOMAIN=

# --- Database (only inside the compose network; no port is published)
POSTGRES_USER=oil
# Long random value, e.g.:  openssl rand -base64 24 | tr -d '/+='
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=oil_change

# --- Company login for the website (D-061). Give the instructor this password for the demo.
# Changing it logs EVERY phone out (task 8.5r, docs/deploy.md "Log everyone out").
UI_PASSWORD=CHANGE_ME
# Signs the 30-day login cookie (task 8.5r). Long random value, never shared:  openssl rand -hex 32
AUTH_SECRET=CHANGE_ME

# --- Contact at the end of every reminder message (D-068).
# 99000000 is a PLACEHOLDER; the reminders screen then warns that the number is fake.
GEO_EXPERT_NAME=Geo-Expert
GEO_EXPERT_PHONE=99000000
# Task 9.5b: the oil changer's phone in the reminders. Empty -> GEO_EXPERT_PHONE is used.
CONTACT_PHONE=

# --- Task 9.5a: next oil change target = odometer at the last change + this many km. Task 9.14a:
# 12000 (was 15000), stored on each service when saved: changing it does not move older targets.
OIL_INTERVAL_KM=12000

# --- Task 9.5c (D-119): one reminder this many days after the latest service, and «Эрсдэлтэй»
# (at risk) this many days after it without a new service. AT_RISK_DAYS must be greater than
# REMINDER_DAYS, or the API does not start.
REMINDER_DAYS=75
AT_RISK_DAYS=150

# --- Task 9.14a: with the truck's km/day known, its reminder goes this many days before the due day
# (must be less than AT_RISK_DAYS); without it, a «Км шалгах» message asks the driver for his km this
# many days after the service (must be less than REMINDER_DAYS).
REMINDER_LEAD_DAYS=5
KM_CHECK_DAYS=34

# --- Task 9.16b: a service not marked «Төлсөн» becomes «Авлага» this many hours after it was saved
# (whole number > 0, or the API does not start). Not ARTLAB_UNPAID_LOOKBACK_DAYS (Artlab only).
PAYMENT_DUE_HOURS=24

# --- Task 9.6b-3: Artlab accounting sync (read-only on Artlab, D-114). Leave EMPTY until the
# accounting OK: the sync timers are not installed before that. Never commit real values.
ARTLAB_URL=
ARTLAB_USER=
ARTLAB_PASS=
# Bank / receivable account codes for the transfer report, comma-separated (from the accountant).
ARTLAB_BANK_ACCOUNTS=
# Payment types that mean "on credit" (seen on the Artlab test DB: LOAN «Зээл»).
ARTLAB_CREDIT_PAY_TYPES=LOAN
# Warn in the log when an account had 0 transfers this many runs in a row (12 x 2 h = 1 day).
ARTLAB_ZERO_ROW_WARN_RUNS=12

# --- Task 9.15a: Messenger km bot. Off by default. Real values ONLY in the server .env (never in git,
# never logged). MESSENGER_ENABLED=true needs ALL the META_* values, or the API does not start.
# MESSENGER_OTN_ENABLED=true (One-Time Notification reminders) needs MESSENGER_ENABLED=true.
# META_VERIFY_TOKEN: make one with  openssl rand -hex 32  (rotate it after the webhook set-up).
# META_GRAPH_VERSION: the Graph API version from the app dashboard, e.g. v26.0 (the only place it is set).
MESSENGER_ENABLED=false
MESSENGER_OTN_ENABLED=false
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_TOKEN=
META_PAGE_ID=
META_GRAPH_VERSION=
# 9.15a-3: the Page username for the m.me link in the km-check SMS (not a secret). Empty = no link.
# Used only with MESSENGER_ENABLED=true. Letters, digits, dots; the name only, not a URL.
MESSENGER_PAGE_USERNAME=
