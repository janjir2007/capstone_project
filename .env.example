# Copy this file to .env and fill in real values. .env is git-ignored.
# Values below are LOCAL DEVELOPMENT defaults only — never put real secrets here.
APP_ENV=local

# --- Database (task 1.1, D-011: local PostgreSQL in Docker)
# Used by docker-compose.yml (db service) and tests/test_schema.py.
# These match the ":-" defaults in docker-compose.yml.
POSTGRES_USER=oil
POSTGRES_PASSWORD=oil_dev_password
POSTGRES_DB=oil_change
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional: a full connection URL. If set, it is used INSTEAD of the POSTGRES_*
# values above (e.g. Supabase later). Leave commented out for local Docker.
# DATABASE_URL=postgresql://oil:oil_dev_password@localhost:5432/oil_change

# --- API (task 4.1)
# Host port for the API container in docker-compose.yml (http://localhost:8000).
API_PORT=8000

# --- Reminder message (task 4.4): contact shown at the end of every Mongolian reminder.
# 99000000 is a PLACEHOLDER (not a real number): the UI shows a yellow warning and the
# API reports contact_is_placeholder: true. Put Geo-Expert's real phone here BEFORE a demo
# (in .env, never committed), then `docker compose up -d` to restart the API.
GEO_EXPERT_NAME=Geo-Expert
GEO_EXPERT_PHONE=99000000
# Task 9.5b: the oil changer's phone in the reminders. Empty -> GEO_EXPERT_PHONE is used.
CONTACT_PHONE=

# --- Task 9.5a: next oil change target = odometer at the last change + this many km. Task 9.14a:
# 12000 (was 15000), stored on each service when saved: changing it does not move older targets.
OIL_INTERVAL_KM=12000

# --- Task 9.5c (D-119): one reminder this many days after the latest service, and «Эрсдэлтэй»
# (at risk) this many days after it without a new service. AT_RISK_DAYS must be greater than
# REMINDER_DAYS, or the API does not start.
REMINDER_DAYS=75
AT_RISK_DAYS=150

# --- Task 9.14a: with the truck's km/day known, its reminder goes this many days before the due day
# (must be less than AT_RISK_DAYS); without it, a «Км шалгах» message asks the driver for his km this
# many days after the service (must be less than REMINDER_DAYS).
REMINDER_LEAD_DAYS=5
KM_CHECK_DAYS=34

# --- Task 9.16b: a service not marked «Төлсөн» becomes «Авлага» this many hours after it was saved
# (whole number > 0, or the API does not start). Not ARTLAB_UNPAID_LOOKBACK_DAYS (Artlab only).
PAYMENT_DUE_HOURS=24

# --- Task 9.15a: Messenger km bot. Off by default. Real values ONLY in the server .env (never in git,
# never logged). MESSENGER_ENABLED=true needs ALL the META_* values, or the API does not start.
# MESSENGER_OTN_ENABLED=true (One-Time Notification reminders) needs MESSENGER_ENABLED=true.
# META_VERIFY_TOKEN: make one with  openssl rand -hex 32  (rotate it after the webhook set-up).
# META_GRAPH_VERSION: the Graph API version from the app dashboard, e.g. v26.0 (the only place it is set).
MESSENGER_ENABLED=false
MESSENGER_OTN_ENABLED=false
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_TOKEN=
META_PAGE_ID=
META_GRAPH_VERSION=
# 9.15a-3: the Page username for the m.me link in the km-check SMS (not a secret). Empty = no link.
# Used only with MESSENGER_ENABLED=true. Letters, digits, dots; the name only, not a URL.
MESSENGER_PAGE_USERNAME=
